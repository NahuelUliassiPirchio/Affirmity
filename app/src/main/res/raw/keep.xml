<?xml version="1.0" encoding="utf-8"?>
<!--
  Resources looked up by name at runtime (Resources.getIdentifier) are invisible to the resource
  shrinker, which removes them from optimized builds (release, benchmark).
  default_web_client_id is generated by the google-services plugin and resolved by name in
  auth/GoogleIdAuthProvider.kt; without it, Google sign-in fails with ConfigurationMissing.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id" />
