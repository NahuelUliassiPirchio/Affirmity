<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Affirmity" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- System-drawn cold-start splash (androidx.core.splashscreen): shown the instant the process
         starts, before Compose ever attaches, so the app never flashes the OS's default white
         background. installSplashScreen() in MainActivity swaps to Theme.Affirmity automatically
         once the first frame is ready. -->
    <style name="Theme.Affirmity.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Affirmity</item>
    </style>
</resources>