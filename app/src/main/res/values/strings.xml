    <string-array name="reflection_prompts_monday">
        <item>Hoy, lunes, ¿cómo te sentiste?</item>
        <item>Arrancamos la semana. ¿Cómo veniste hoy, lunes?</item>
        <item>Lunes de nuevo. ¿Cómo estuvo tu ánimo hoy?</item>
        <item>¿Qué es lo más honesto que podrías decirte hoy?</item>
        <item>¿Hay algo que estuviste evitando mirar esta semana?</item>
        <item>¿Hacia dónde apunta tu brújula hoy: hacia adentro o hacia afuera?</item>
        <item>¿Qué verdad incómoda podrías reconocerte hoy, lunes?</item>
    </string-array>
    <string-array name="reflection_prompts_tuesday">
        <item>Hoy, martes, ¿cómo te sentiste?</item>
        <item>¿Cómo va este martes? Contanos cómo te sentiste.</item>
        <item>Martes al día. ¿Cómo estuvo tu ánimo hoy?</item>
        <item>¿Qué estás sintiendo que todavía no te animaste a nombrar?</item>
        <item>¿A quién le debés una conversación honesta?</item>
        <item>¿Qué parte de vos estuviste ignorando últimamente?</item>
        <item>Si fueras totalmente honesto con vos, ¿qué cambiarías hoy?</item>
    </string-array>
    <string-array name="reflection_prompts_wednesday">
        <item>Hoy, miércoles, ¿cómo te sentiste?</item>
        <item>Mitad de semana. ¿Cómo veniste hoy, miércoles?</item>
        <item>¿Cómo estuvo tu ánimo este miércoles?</item>
        <item>¿Qué te está costando aceptar de vos mismo?</item>
        <item>¿Hay una excusa que te repetís seguido? ¿Es cierta?</item>
        <item>¿Qué necesitás escuchar de vos mismo hoy?</item>
        <item>¿En qué momento del día de hoy fuiste más vos?</item>
    </string-array>
    <string-array name="reflection_prompts_thursday">
        <item>Hoy, jueves, ¿cómo te sentiste?</item>
        <item>Ya casi. ¿Cómo estuvo tu ánimo hoy, jueves?</item>
        <item>Jueves al día. Contanos cómo te sentiste.</item>
        <item>¿Qué verdad sobre vos mismo te cuesta aceptar?</item>
        <item>¿Qué estás postergando por miedo, no por falta de tiempo?</item>
        <item>¿Dónde sentís que no estás siendo del todo honesto con vos?</item>
        <item>¿Qué te diría tu brújula interna si le hicieras caso hoy?</item>
    </string-array>
    <string-array name="reflection_prompts_friday">
        <item>Hoy, viernes, ¿cómo te sentiste?</item>
        <item>Llegaste al viernes. ¿Cómo veniste hoy?</item>
        <item>¿Cómo estuvo tu ánimo en este viernes?</item>
        <item>Mirando la semana, ¿qué fuiste evitando sentir?</item>
        <item>¿Qué decisión tomaste esta semana sin ser del todo honesto con vos?</item>
        <item>¿Qué necesitás soltar antes de que arranque el finde?</item>
        <item>¿Qué es lo más real que te pasó esta semana?</item>
    </string-array>
    <string-array name="reflection_prompts_saturday">
        <item>Hoy, sábado, ¿cómo te sentiste?</item>
        <item>Fin de semana. ¿Cómo veniste hoy, sábado?</item>
        <item>¿Cómo estuvo tu ánimo este sábado?</item>
        <item>Sin nada que cumplir hoy, ¿qué sentís de verdad?</item>
        <item>¿Qué parte de tu vida necesita más honestidad?</item>
        <item>¿Qué te gustaría admitirte hoy que nunca dirías en voz alta?</item>
        <item>¿Hacia dónde te está llevando tu brújula últimamente?</item>
    </string-array>
    <string-array name="reflection_prompts_sunday">
        <item>Hoy, domingo, ¿cómo te sentiste?</item>
        <item>Último día del finde. ¿Cómo veniste hoy, domingo?</item>
        <item>¿Cómo estuvo tu ánimo este domingo?</item>
        <item>Antes de arrancar la semana que viene, ¿qué necesitás reconocerte?</item>
        <item>¿Qué verdad querés llevarte de esta semana?</item>
        <item>¿Con qué intención honesta te gustaría empezar la próxima semana?</item>
        <item>¿Qué verdad incómoda podrías admitirte hoy?</item>
    </string-array>

