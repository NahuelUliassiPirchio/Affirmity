<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview (RemoteViews-safe widgets only): the medium carousel card, mirroring CarouselContent. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_carousel_card">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="top|end"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_carousel_marker_medium"
        tools:ignore="UseAppTint" android:tintMode="src_in" android:tint="@color/widget_preview_marker" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="15dp"
        android:paddingEnd="16dp"
        android:paddingBottom="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="HardcodedText"
                android:text="&#x2726;"
                android:textColor="@color/widget_preview_star"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="@string/widget_preview_carousel_theme"
                android:textColor="@color/widget_preview_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:maxLines="3"
                android:text="@string/widget_preview_carousel_title"
                android:textColor="@color/widget_preview_title"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="2"
                android:text="@string/widget_preview_carousel_subtitle"
                android:textColor="@color/widget_preview_subtitle"
                android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
