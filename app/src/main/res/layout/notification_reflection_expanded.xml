<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reflection_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_reflection_card_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/reflection_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/notif_reflection_accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:importantForAccessibility="no"
        android:text="&#8220;"
        android:textColor="@color/notif_reflection_accent"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/reflection_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:textColor="@color/notif_reflection_text"
        android:textSize="20sp" />
</LinearLayout>
