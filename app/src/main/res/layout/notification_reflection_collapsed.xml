<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reflection_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_reflection_card_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/reflection_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/notif_reflection_accent"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeMaxTextSize="12sp"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/reflection_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:fontFamily="serif"
        android:textColor="@color/notif_reflection_text"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeMaxTextSize="15sp"
        android:textSize="15sp" />
</LinearLayout>
