<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Room database holds free-text mood notes; excluded from Auto Backup (pre-API-31 devices). -->
    <exclude domain="database" path="affirmity.db"/>
    <exclude domain="database" path="affirmity.db-shm"/>
    <exclude domain="database" path="affirmity.db-wal"/>
</full-backup-content>