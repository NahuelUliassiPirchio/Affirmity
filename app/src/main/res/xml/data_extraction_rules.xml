<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- Room database holds free-text mood notes; excluded from cloud backup and device transfer (API 31+). -->
    <cloud-backup>
        <exclude domain="database" path="affirmity.db"/>
        <exclude domain="database" path="affirmity.db-shm"/>
        <exclude domain="database" path="affirmity.db-wal"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="affirmity.db"/>
        <exclude domain="database" path="affirmity.db-shm"/>
        <exclude domain="database" path="affirmity.db-wal"/>
    </device-transfer>
</data-extraction-rules>