<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker fallback below API 31 (no previewLayout): dark card with a week of day cells and a legend.
     Layers are explicitly sized and placed with top|left gravity, so the geometry never depends on the canvas. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="300dp" android:height="120dp" />
            <corners android:radius="20dp" />
            <solid android:color="@color/widget_preview_tracker_surface" />
        </shape>
    </item>
    <!-- Seven day cells: 26dp circles, 36dp apart. -->
    <item android:gravity="top|left" android:left="20dp" android:top="30dp" android:width="26dp" android:height="26dp">
        <shape android:shape="oval"><solid android:color="@color/widget_preview_tracker_affirm" /></shape>
    </item>
    <item android:gravity="top|left" android:left="56dp" android:top="30dp" android:width="26dp" android:height="26dp">
        <shape android:shape="oval"><solid android:color="@color/widget_preview_tracker_meditate" /></shape>
    </item>
    <item android:gravity="top|left" android:left="92dp" android:top="30dp" android:width="26dp" android:height="26dp">
        <shape android:shape="oval"><solid android:color="@color/widget_preview_tracker_affirm" /></shape>
    </item>
    <item android:gravity="top|left" android:left="128dp" android:top="30dp" android:width="26dp" android:height="26dp">
        <shape android:shape="oval"><solid android:color="@color/widget_preview_tracker_meditate" /></shape>
    </item>
    <item android:gravity="top|left" android:left="164dp" android:top="30dp" android:width="26dp" android:height="26dp">
        <shape android:shape="oval"><solid android:color="@color/widget_preview_tracker_empty" /></shape>
    </item>
    <item android:gravity="top|left" android:left="200dp" android:top="30dp" android:width="26dp" android:height="26dp">
        <shape android:shape="oval"><solid android:color="@color/widget_preview_tracker_empty" /></shape>
    </item>
    <item android:gravity="top|left" android:left="236dp" android:top="30dp" android:width="26dp" android:height="26dp">
        <shape android:shape="oval"><solid android:color="@color/widget_preview_tracker_empty" /></shape>
    </item>
    <!-- Legend bars. -->
    <item android:gravity="top|left" android:left="20dp" android:top="78dp" android:width="60dp" android:height="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/widget_preview_tracker_affirm" />
        </shape>
    </item>
    <item android:gravity="top|left" android:left="96dp" android:top="78dp" android:width="60dp" android:height="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/widget_preview_tracker_meditate" />
        </shape>
    </item>
</layer-list>
