<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview: the dark design-8 card with a teal corner marker and text lines. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <!-- Gives the layer-list an intrinsic size (the insets below assume this canvas). -->
            <size android:width="250dp" android:height="200dp" />
            <corners android:radius="22dp" />
            <solid android:color="#FF0F1216" />
            <stroke
                android:width="1dp"
                android:color="#12FFFFFF" />
        </shape>
    </item>
    <item
        android:left="120dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="100dp">
        <shape android:shape="rectangle">
            <corners android:topRightRadius="22dp" android:bottomLeftRadius="30dp" />
            <solid android:color="#385AB3C8" />
        </shape>
    </item>
    <item
        android:left="20dp"
        android:top="28dp"
        android:right="150dp"
        android:bottom="110dp">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#995BBCC3" />
        </shape>
    </item>
    <item
        android:left="20dp"
        android:top="96dp"
        android:right="70dp"
        android:bottom="48dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#FFF2F3F5" />
        </shape>
    </item>
    <item
        android:left="20dp"
        android:top="124dp"
        android:right="110dp"
        android:bottom="28dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#80B4B9C0" />
        </shape>
    </item>
</layer-list>
