rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Generic per-user documents (affirmations, dailyCompletions, settings, meta). Deliberately
    // does NOT use a recursive {document=**} wildcard: Firestore rule evaluation is OR'd across
    // every matching block, so a blanket wildcard here would silently grant unrestricted access
    // to fcmTokens/notificationPlans too, making their shape validation below unenforceable.
    match /users/{uid}/affirmations/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/dailyCompletions/{epochDay} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/dailyMoods/{epochDay} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/streakHealerUses/{epochDay} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/settings/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/meta/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Owner-only, shape-validated: token id must match the doc id and platform must be "android".
    match /users/{uid}/fcmTokens/{token} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.token == token
        && request.resource.data.platform == 'android';
    }

    // Server-written only (Admin SDK bypasses rules); owner may read their own plan.
    match /users/{uid}/notificationPlans/{day} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Server-written only (Admin SDK bypasses rules) -- the client can never grant itself Pro.
    // Written exclusively by the `playRtdn`/`syncEntitlement` Cloud Functions after re-verifying
    // the purchase against the Play Developer API (design.md's D1/D4). Owner may read their own
    // entitlement to drive gating; write is unconditionally denied, including to the owner.
    match /users/{uid}/entitlements/{doc} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Client-writable by design, unlike the entitlement doc above: the CLIENT observes rewarded-ad
    // completion, so there is no server signal to write from. Deliberate, recorded weakening
    // (Spec 1 design, Q7) -- a modified client can self-grant an ad unlock, which is accepted for
    // low-value content. What rules DO enforce: owner-only, a closed field set, a doc id that
    // agrees with its own fields, and CREATE-ONLY, so a consumed ONE_TIME_TRIAL can never be
    // erased or back-dated by the client.
    match /users/{uid}/adUnlocks/{contentKey} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['contentType', 'contentId', 'grantedAtMillis', 'expiresAtMillis'])
        && request.resource.data.keys().hasAll(
             ['contentType', 'contentId', 'grantedAtMillis'])
        && request.resource.data.contentType is string
        && request.resource.data.contentId is string
        && contentKey == request.resource.data.contentType + '_' + request.resource.data.contentId
        && request.resource.data.grantedAtMillis is int
        && (!('expiresAtMillis' in request.resource.data.keys())
            || request.resource.data.expiresAtMillis == null
            || request.resource.data.expiresAtMillis is int);

      allow update, delete: if false;
    }

    // TIMED_REPEATABLE grants (design D16). A SIBLING of users/{uid}/adUnlocks above, never a
    // reuse of it: update is allowed here and ONLY here, because re-earning a window after
    // expiry is an overwrite by definition. Delete stays denied so a client cannot erase an
    // active window and restart it early -- the anti-back-dating property that matters for a
    // timed grant.
    match /users/{uid}/timedUnlocks/{contentKey} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['contentType', 'contentId', 'grantedAtMillis', 'expiresAtMillis'])
        && request.resource.data.keys().hasAll(
             ['contentType', 'contentId', 'grantedAtMillis', 'expiresAtMillis'])
        && contentKey == request.resource.data.contentType + '_' + request.resource.data.contentId
        && request.resource.data.grantedAtMillis is int
        && request.resource.data.expiresAtMillis is int // NON-null here, unlike adUnlocks
        && request.resource.data.expiresAtMillis > request.resource.data.grantedAtMillis;

      allow delete: if false;
    }

    // Shared, read-only curated catalog (design D1/D12). World-readable so an unauthenticated
    // first launch can refresh the version marker; client writes are unconditionally denied.
    // Written exclusively by `functions/tools/seedCatalog.ts` via the Admin SDK, which bypasses
    // rules. The blast radius of `allow read: if true` is "someone copies content that is already
    // in every downloaded APK" (design D2) -- there is no user data in any of these collections.
    match /catalogAffirmations/{id}   { allow read: if true; allow write: if false; }
    match /catalogUniverses/{id}      { allow read: if true; allow write: if false; }
    match /catalogThemes/{id}         { allow read: if true; allow write: if false; }
    match /catalogCollections/{id}    { allow read: if true; allow write: if false; }
    match /catalogMeta/{doc}          { allow read: if true; allow write: if false; }

    // Per-user placeholder overrides on shared catalog rows (spec: catalog-token-overrides).
    // Owner-only, same posture as users/{uid}/affirmations above. Deliberately NOT covered by the
    // recursive-wildcard-avoidance comment at the top of this file -- this block IS the specific
    // rule for this sub-collection.
    match /users/{uid}/catalogOverrides/{catalogAffirmationId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Notifications V2 copy catalog (design §1, `notification-copy-catalog` capability).
    // Server/Admin-SDK-only, unlike the world-readable `catalogAffirmations` block above: the
    // client never reads this directly -- it has static per-channel fallback strings instead, and
    // copy selection/rendering happens entirely at send time inside `sendNotification`. Written
    // exclusively by `functions/tools/seedCopyCatalog.ts` via the Admin SDK, which bypasses rules.
    match /notificationCopy/{variantKey} {
      allow read: if false;
      allow write: if false;
    }

    // Notifications V2 per-user anti-repeat + cooldown state (design §2). Server-written only --
    // `sendNotification` merge-writes this after every successful send via the Admin SDK, which
    // bypasses rules. Owner may read their own state (harmless: it only reveals which copy
    // variants they were recently shown), but a client write could defeat the anti-repeat
    // guarantee entirely, so write is unconditionally denied, including to the owner.
    match /users/{uid}/notificationState/{doc} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Notifications V2 per-day, per-family delivery log (design §2/§3). Backs the send-time
    // cross-family freshness checks (e.g. Compass-too-soon-after-Mood, one-delivery-per-family-
    // per-day). Same posture as notificationState above: owner-read, server-write-only.
    match /users/{uid}/notificationDeliveries/{localDay} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Notifications V2 Compass-answer tracking (design D9). Drives the send-time
    // `compassAnsweredToday` suppression check. Server-written only, like the two collections
    // above: even though the *event* (answering a Compass question) originates from the client,
    // the write happens through a Cloud Function so it can be trusted as the single source of
    // truth for suppression -- a client-writable doc here would let a client fake "answered" to
    // silence its own Compass notifications, which is low-stakes, but keeping all three
    // Notifications V2 server-state collections on one write posture avoids a special case.
    match /users/{uid}/compassAnswers/{localDay} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
