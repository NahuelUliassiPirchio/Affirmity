rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Generic per-user documents (affirmations, dailyCompletions, settings, meta). Deliberately
    // does NOT use a recursive {document=**} wildcard: Firestore rule evaluation is OR'd across
    // every matching block, so a blanket wildcard here would silently grant unrestricted access
    // to fcmTokens/notificationPlans too, making their shape validation below unenforceable.
    match /users/{uid}/affirmations/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/dailyCompletions/{epochDay} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/dailyMoods/{epochDay} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/streakHealerUses/{epochDay} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/settings/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/meta/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Owner-only, shape-validated: token id must match the doc id and platform must be "android".
    match /users/{uid}/fcmTokens/{token} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.token == token
        && request.resource.data.platform == 'android';
    }

    // Server-written only (Admin SDK bypasses rules); owner may read their own plan.
    match /users/{uid}/notificationPlans/{day} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Server-written only (Admin SDK bypasses rules) -- the client can never grant itself Pro.
    // Written exclusively by the `playRtdn`/`syncEntitlement` Cloud Functions after re-verifying
    // the purchase against the Play Developer API (design.md's D1/D4). Owner may read their own
    // entitlement to drive gating; write is unconditionally denied, including to the owner.
    match /users/{uid}/entitlements/{doc} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Client-writable by design, unlike the entitlement doc above: the CLIENT observes rewarded-ad
    // completion, so there is no server signal to write from. Deliberate, recorded weakening
    // (Spec 1 design, Q7) -- a modified client can self-grant an ad unlock, which is accepted for
    // low-value content. What rules DO enforce: owner-only, a closed field set, a doc id that
    // agrees with its own fields, and CREATE-ONLY, so a consumed ONE_TIME_TRIAL can never be
    // erased or back-dated by the client.
    match /users/{uid}/adUnlocks/{contentKey} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['contentType', 'contentId', 'grantedAtMillis', 'expiresAtMillis'])
        && request.resource.data.keys().hasAll(
             ['contentType', 'contentId', 'grantedAtMillis'])
        && request.resource.data.contentType is string
        && request.resource.data.contentId is string
        && contentKey == request.resource.data.contentType + '_' + request.resource.data.contentId
        && request.resource.data.grantedAtMillis is int
        && (!('expiresAtMillis' in request.resource.data.keys())
            || request.resource.data.expiresAtMillis == null
            || request.resource.data.expiresAtMillis is int);

      allow update, delete: if false;
    }

    // TIMED_REPEATABLE grants (design D16). A SIBLING of users/{uid}/adUnlocks above, never a
    // reuse of it: update is allowed here and ONLY here, because re-earning a window after
    // expiry is an overwrite by definition. Delete stays denied so a client cannot erase an
    // active window and restart it early -- the anti-back-dating property that matters for a
    // timed grant.
    match /users/{uid}/timedUnlocks/{contentKey} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['contentType', 'contentId', 'grantedAtMillis', 'expiresAtMillis'])
        && request.resource.data.keys().hasAll(
             ['contentType', 'contentId', 'grantedAtMillis', 'expiresAtMillis'])
        && contentKey == request.resource.data.contentType + '_' + request.resource.data.contentId
        && request.resource.data.grantedAtMillis is int
        && request.resource.data.expiresAtMillis is int // NON-null here, unlike adUnlocks
        && request.resource.data.expiresAtMillis > request.resource.data.grantedAtMillis;

      allow delete: if false;
    }
  }
}
